{
  "name": "@letmepost/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "predev": "node scripts/copy-openapi.mjs",
    "dev": "tsx watch --import ./instrument.mjs src/server.ts",
    "worker": "tsx --import ./instrument.mjs src/queue/worker.ts",
    "prebuild": "node scripts/copy-openapi.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-openapi.mjs",
    "start": "node --import ./instrument.mjs dist/server.js",
    "start:api": "node dist/db/migrate.js && node --import ./instrument.mjs dist/server.js",
    "start:worker": "node --import ./instrument.mjs dist/queue/worker.js",
    "migrate": "node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/copy-openapi.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "preflight:queued": "tsx scripts/preflight-queued.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@better-auth/core": "^1.6.29",
    "@better-auth/oauth-provider": "^1.6.29",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.1",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.9.0",
    "@letmepost/mcp": "workspace:*",
    "@letmepost/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.70.0",
    "better-auth": "^1.6.29",
    "better-call": "1.4.0",
    "bullmq": "^5.81.3",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.5.2",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.20.0",
    "svix": "^1.99.1",
    "ws": "^8.21.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@letmepost/config-tsconfig": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
